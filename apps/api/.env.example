# ─── Banco de dados ────────────────────────────────────────────────
# Obter em: https://neon.tech → New Project → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/presteza?sslmode=require"

# ─── JWT ───────────────────────────────────────────────────────────
# Gere uma string aleatória segura (ex: openssl rand -base64 32)
JWT_SECRET="troque-por-uma-chave-segura-aqui"
JWT_EXPIRES_IN="7d"

# ─── Servidor ──────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── Storage (Cloudflare R2) — preencher na Sprint 4 ───────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="presteza-docs"
R2_PUBLIC_URL=""
